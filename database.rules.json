{
  "rules": {
    ".read": false,
    ".write": false,
    
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      "global_announcement": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      },
      "maintenance_mode": {
        ".read": true,
        ".write": "auth != null && auth.token.admin === true"
      },
      "safety": {
        "profanity_list": {
          ".read": true,
          ".write": "auth != null && auth.token.admin === true"
        }
      }
    },
    
    "admin": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true",
      "reports": {
        ".read": "auth != null && auth.token.admin === true",
        "$reportId": {
          ".write": "!data.exists() && newData.exists() && newData.hasChildren(['reportedId', 'reason', 'timestamp'])"
        }
      },
      "blacklist": {
        "$uid": {
          ".read": true,
          ".write": "auth != null && auth.token.admin === true"
        }
      },
      "appeals": {
        "$uid": {
          ".read": "auth != null && auth.token.admin === true",
          ".write": "!data.exists() && newData.exists() && newData.hasChildren(['reason', 'timestamp'])"
        }
      },
      "violations": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    
    "lobby": {
      ".read": true,
      "$sessionId": {
        ".write": true,
        ".validate": "!newData.exists() || newData.hasChildren(['timestamp']) || newData.hasChild('signal') || newData.hasChild('code')"
      }
    },

    "game_lobby": {
      ".read": true,
      "$gameId": {
        ".read": true,
        "$playerId": {
          ".write": true
        }
      }
    },
    
    "matches": {
      ".read": true,
      "$matchId": {
        ".write": true,
        ".validate": "!newData.exists() || newData.hasChildren(['user1', 'user2', 'roomId'])"
      }
    },
    
    "rooms": {
      ".read": true,
      "$roomId": {
        ".write": true
      }
    },

    "game_reactions": {
      ".read": true,
      "$roomCode": {
        ".read": true,
        "$reactionId": {
          ".write": true
        }
      }
    },

    "game_chat": {
      ".read": true,
      "$roomCode": {
        ".read": true,
        "$messageId": {
          ".write": true
        }
      }
    },
    
    "analytics": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": true
    },

    "presence": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "!newData.exists() || newData.hasChildren(['online_at'])"
      }
    }
  }
}
