{
  "rules": {
    ".read": false,
    ".write": false,

    "settings": {
      "safety": {
        "profanity_list": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },

    "admin": {
      "reports": {
        ".read": "auth != null",
        "$reportId": {
          ".write": true
        }
      },
      "blacklist": {
        ".read": true,
        "$uid": {
          ".write": "auth != null"
        }
      },
      "appeals": {
        ".read": "auth != null",
        "$uid": {
          ".write": true
        }
      },
      "violations": {
        ".read": "auth != null",
        "$uid": {
          ".write": true
        }
      }
    },

    "lobby": {
      ".read": true,
      "$sessionId": {
        ".write": "auth != null || !newData.exists()"
      }
    },

    "matches": {
      ".read": true,
      "$matchId": {
        ".write": "auth != null || !newData.exists()",
        ".validate": "!newData.exists() || newData.hasChildren(['user1', 'user2', 'roomId'])"
      }
    },

    "rooms": {
      ".read": true,
      "$roomId": {
        ".write": "auth != null || !newData.exists()"
      }
    },

    "analytics": {
      ".read": true,
      ".write": "auth != null"
    },

    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null || !newData.exists()",
        ".validate": "!newData.exists() || newData.hasChildren(['online_at'])"
      }
    }
  }
}
