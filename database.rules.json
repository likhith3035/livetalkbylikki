{
  "rules": {
    ".read": true,
    ".write": false,
    
    "settings": {
      ".read": true,
      ".write": true,
      "global_announcement": {
        ".read": true,
        ".write": true
      },
      "maintenance_mode": {
        ".read": true,
        ".write": true
      },
      "safety": {
        "profanity_list": {
          ".read": true,
          ".write": true
        }
      }
    },
    
    "admin": {
      ".read": true,
      ".write": true,
      "reports": {
        ".read": true,
        "$reportId": {
          ".write": true
        }
      },
      "blacklist": {
        ".read": true,
        "$uid": {
          ".write": true
        }
      },
      "appeals": {
        ".read": true,
        "$uid": {
          ".write": true
        }
      },
      "violations": {
        ".read": true,
        "$uid": {
          ".write": true
        }
      }
    },
    
    "lobby": {
      ".read": true,
      ".write": true,
      "$sessionId": {
        ".write": true
      }
    },
    
    "matches": {
      ".read": true,
      "$matchId": {
        ".write": true,
        ".validate": "!newData.exists() || newData.hasChildren(['user1', 'user2', 'roomId'])"
      }
    },
    
    "rooms": {
      ".read": true,
      "$roomId": {
        ".write": true
      }
    },
    
    "analytics": {
      ".read": true,
      ".write": true
    },

    "presence": {
      ".read": true,
      ".write": true,
      "$uid": {
        ".write": true,
        ".validate": "!newData.exists() || newData.hasChildren(['online_at'])"
      }
    }
  }
}
